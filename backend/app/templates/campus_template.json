  "declared_relationship_types": [
    { "relationship_type": "serviced_by_road", "source_entity_type": "building", "target_entity_type": "road" },
    { "relationship_type": "traverses", "source_entity_type": "bus", "target_entity_type": "road" },
    { "relationship_type": "located_at", "source_entity_type": "event", "target_entity_type": "building" },
    { "relationship_type": "traveling_to", "source_entity_type": "student", "target_entity_type": "building" }
  ],
  "metrics": [
    {
      "name": "road_congestion",
      "display_name": "Average Road Congestion Index",
      "description": "Mean congestion ratio (current flow / road capacity) across active campus roadways.",
      "unit": "ratio",
      "healthy_min": 0.1,
      "healthy_max": 0.55,
      "computation_type": "avg_state_field",
      "target_entity_type": "road",
      "target_field": "congestion_index"
    },
    {
      "name": "bus_occupancy_rate",
      "display_name": "Average Bus Occupancy Rate",
      "description": "Mean passenger load factor across all active campus shuttles.",
      "unit": "ratio",
      "healthy_min": 0.3,
      "healthy_max": 0.75,
      "computation_type": "avg_state_field",
      "target_entity_type": "bus",
      "target_field": "occupancy_rate"
    },
    {
      "name": "avg_commute_time",
      "display_name": "Student Average Commute Time",
      "description": "Mean duration in minutes for student transit between campus nodes.",
      "unit": "minutes",
      "healthy_min": 10.0,
      "healthy_max": 25.0,
      "computation_type": "avg_state_field",
      "target_entity_type": "student",
      "target_field": "commute_time_minutes"
    },
    {
      "name": "building_density",
      "display_name": "Campus Building Density",
      "description": "Mean utilization ratio of building capacity across campus facilities.",
      "unit": "ratio",
      "healthy_min": 0.2,
      "healthy_max": 0.7,
      "computation_type": "ratio_state_attribute",
      "target_entity_type": "building",
      "state_field": "current_occupancy",
      "attr_field": "capacity"
    },
    {
      "name": "system_flow_efficiency",
      "display_name": "Overall Campus Flow Efficiency",
      "description": "Composite operational flow index balancing roadway throughput and student transit delay.",
      "unit": "index",
      "healthy_min": 0.70,
      "healthy_max": 0.98,
      "computation_type": "composite_flow_efficiency",
      "target_entity_type": "world",
      "target_field": "efficiency"
    }
  ],
  "scenario_vocabulary": [
    {
      "action": "close_road",
      "display_name": "Road Closure / Maintenance",
      "description": "Blocks a specified roadway or segment, diverting traffic flow onto adjacent routes.",
      "target_entity_types": ["road"],
      "allowed_parameters": [
        { "name": "road_id", "type": "string", "description": "ID or name of the target road" },
        { "name": "duration_steps", "type": "integer", "description": "Duration of closure in simulation steps", "default": 60 }
      ],
      "example_phrases": [
        "Close Central Academic Avenue for water pipe repair",
        "Block Pavilion Transit Loop due to emergency maintenance",
        "Shut down North Campus Parkway"
      ]
    },
    {
      "action": "increase_bus_frequency",
      "display_name": "Increase Shuttle Frequency",
      "description": "Deploys extra buses or decreases headways to reduce shuttle waiting times and passenger overcrowding.",
      "target_entity_types": ["bus"],
      "allowed_parameters": [
        { "name": "multiplier", "type": "number", "description": "Frequency boost factor (e.g., 1.5 or 2.0)", "default": 1.5 },
        { "name": "route_name", "type": "string", "description": "Specific route to boost, or 'all'", "default": "all" }
      ],
      "example_phrases": [
        "Double the bus frequency on all campus shuttle routes",
        "Add more buses to the Union and Dorms Direct route",
        "Increase shuttle frequency by 50% during peak event hours"
      ]
    },
    {
      "action": "reroute_buses",
      "display_name": "Reroute Campus Transit",
      "description": "Diverts bus lines away from congested or closed corridors onto alternate perimeter roads.",
      "target_entity_types": ["bus", "road"],
      "allowed_parameters": [
        { "name": "avoid_road_id", "type": "string", "description": "Road corridor to bypass" },
        { "name": "alternate_road_id", "type": "string", "description": "Alternate road to route through" }
      ],
      "example_phrases": [
        "Reroute buses to avoid Pavilion Transit Loop",
        "Divert shuttle traffic via Perimeter Connector"
      ]
    },
    {
      "action": "shift_class_schedule",
      "display_name": "Stagger Class Start Times",
      "description": "Staggers lecture start and end times by 15-30 minutes across departments to distribute pedestrian peaks.",
      "target_entity_types": ["building", "student"],
      "allowed_parameters": [
        { "name": "stagger_minutes", "type": "integer", "description": "Minutes of stagger", "default": 20 }
      ],
      "example_phrases": [
        "Stagger lecture start times by 20 minutes to reduce peak corridor crowding",
        "Spread out class dismissal times between Science and Administration halls"
      ]
    },
    {
      "action": "host_event",
      "display_name": "Schedule Special Event",
      "description": "Triggers a high-attendance campus gathering creating pedestrian surges and localized traffic spikes.",
      "target_entity_types": ["event", "building"],
      "allowed_parameters": [
        { "name": "location_id", "type": "string", "description": "Host building ID" },
        { "name": "attendance", "type": "integer", "description": "Anticipated attendees", "default": 1000 }
      ],
      "example_phrases": [
        "Host a regional robotics competition at Science Complex with 1500 visitors",
        "Schedule a concert at Student Union Pavilion"
      ]
    }
  ],
  "initial_knowledge": [
    {
      "title": "Campus Transportation & Mobility Master Plan",
      "category": "mobility",
      "content": "Campus transit operates four key lines connecting residential dorms to academic clusters. Central Academic Avenue and Pavilion Transit Loop experience severe congestion during class transition windows (10-minute intervals). Closing Central Academic Avenue without rerouting shuttle lines increases average student commute time by over 45% and causes bus delays to compound exponentially. Implementing a 20-minute class stagger flattens peak pedestrian density by 32%."
    },
    {
      "title": "Pavilion Event Traffic & Safety Protocols",
      "category": "event_management",
      "content": "Special events with over 800 attendees at the Student Union & Event Pavilion create immediate vehicle bottlenecks on Pavilion Transit Loop. Road capacity of 25 vehicles/min is exceeded within 15 minutes of event start if overflow parking is not activated. Standard intervention protocol requires: 1) Increasing shuttle frequency by 1.5x on Union routes, and 2) Diverting commercial delivery vehicles to Perimeter Connector."
    },
    {
      "title": "Emergency Access and Route Redundancy Guidelines",
      "category": "safety",
      "content": "North Campus Parkway and Perimeter Connector serve as designated emergency vehicle arterial corridors. At least one 2-lane corridor must maintain a congestion index below 0.60 at all times. Simultaneous closure of North Campus Parkway and Central Academic Avenue is prohibited under University Safety Directive 4.2."
    }
  ]
}
